# QloApps compose configuration
# Copy to .env and adjust. Development values only. NEVER commit .env.

# Database
DB_NAME=qloapps
DB_USER=qloapps
DB_PASSWD=change_me_dev_db_password
MARIADB_ROOT_PASSWORD=change_me_dev_root_password
DB_PREFIX=qlo_

# Host port that maps to the container's nginx :80
HTTP_PORT=8081
SHOP_DOMAIN=localhost:8081

# Leave all three empty to generate persistent keys in a named volume.
# Existing sites may provide all three keys to preserve current cookies.
COOKIE_KEY=
COOKIE_IV=
NEW_COOKIE_KEY=
