{block name='fh_home_blog'}
{if isset($fh_blog_home) && $fh_blog_home|@count}
<section class="ru-section ru-section--paper"><div class="ru-container"><header class="ru-section-head"><div><p class="ru-eyebrow">{l s='From the field' mod='fhblog'}</p><h2>{l s='Stories worth taking your time with' mod='fhblog'}</h2></div><a class="ru-link" href="{$fh_blog_home_url|escape:'html':'UTF-8'}">{l s='All stories' mod='fhblog'}</a></header><div class="ru-story-grid">{foreach $fh_blog_home as $post}<article class="ru-story"><a href="{$fh_blog_home_url|escape:'html':'UTF-8'}&id_blog_post={$post.id_blog_post|intval}">{if $post.cover}<img loading="lazy" src="{$smarty.const._PS_IMG_}fhblog/{$post.cover|escape:'html':'UTF-8'}" alt="{$post.title|escape:'html':'UTF-8'}">{else}<span class="ru-story__fallback" aria-hidden="true">{$post.title|substr:0:1}</span>{/if}</a><p class="ru-story__meta">{if $post.category_name}{$post.category_name|escape:'html':'UTF-8'}{else}{l s='Countryside journal' mod='fhblog'}{/if}</p><h3><a href="{$fh_blog_home_url|escape:'html':'UTF-8'}&id_blog_post={$post.id_blog_post|intval}">{$post.title|escape:'html':'UTF-8'}</a></h3><p>{$post.excerpt|escape:'html':'UTF-8'}</p></article>{/foreach}</div></div></section>
{/if}
{/block}
